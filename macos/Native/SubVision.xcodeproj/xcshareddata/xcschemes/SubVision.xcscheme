               BlueprintName = "SubVisionTests"
               ReferencedContainer = "container:SubVision.xcodeproj">
            </BuildableReference>
         </TestableReference>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "5B0000000000000000000701"
            BuildableName = "SubVision.app"
            BlueprintName = "SubVision"
            ReferencedContainer = "container:SubVision.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
      <EnvironmentVariables>
         <!-- The engine runs from the worktree in Debug: a Python change needs no rebuild. -->
         <EnvironmentVariable
            key = "SUBVISION_CODE"
            value = "$(SRCROOT)/../.."
            isEnabled = "YES">
         </EnvironmentVariable>
         <!-- The Debug state folder, apart from the release one. -->
         <EnvironmentVariable
            key = "SUBVISION_STATO"
            value = "$(HOME)/Library/Application Support/SubVision-dev"
            isEnabled = "YES">
         </EnvironmentVariable>
         <!-- An ffmpeg of your own for the engine (off: the downloaded one). -->
         <EnvironmentVariable
            key = "SUBVISION_FFMPEG"
            value = "/opt/homebrew/bin/ffmpeg"
            isEnabled = "NO">
         </EnvironmentVariable>
      </EnvironmentVariables>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
   </ProfileAction>
   <AnalyzeAction
